DATABASE_URL="postgresql://postgres:postgres@localhost:5432/behshahr_delivery?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
NODE_ENV=development

# SMS: console is for local development/tests only. Use ippanel in production.
SMS_PROVIDER=console
DEV_OTP_CODE=123456
OTP_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# IPPanel Edge pattern SMS. Never commit real credentials.
IPPANEL_API_KEY=
IPPANEL_FROM_NUMBER=
IPPANEL_OTP_PATTERN_CODE=
IPPANEL_OTP_PARAM_NAME=code
IPPANEL_API_BASE_URL=https://edge.ippanel.com/v1
IPPANEL_TIMEOUT_MS=5000

# Optional WooCommerce inbound integration. Empty disables the endpoint.
WOOCOMMERCE_INTEGRATION_KEY=

# Legacy service-area fallback. Used only until the first database service zone is created.
SERVICE_CENTER_LAT=
SERVICE_CENTER_LNG=
SERVICE_RADIUS_METERS=

# Routing: approximate (default), mapir, neshan, or auto.
# Auto tries Map.ir first when configured, then Neshan, then approximate fallback.
ROUTING_PROVIDER=approximate
ROUTE_DISTANCE_FACTOR=1.25
ROUTE_AVG_SPEED_KMH=25

# Never commit real provider keys. Configure them only in deployment secrets/environment.
MAPIR_API_KEY=
MAPIR_API_BASE_URL=https://map.ir
MAPIR_ROUTING_TIMEOUT_MS=5000
NESHAN_SERVICE_API_KEY=
NESHAN_API_BASE_URL=https://api.neshan.org
NESHAN_ROUTING_TIMEOUT_MS=5000
