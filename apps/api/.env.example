DATABASE_URL="postgresql://postgres:postgres@localhost:5432/behshahr_delivery?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
NODE_ENV=development
SMS_PROVIDER=console
DEV_OTP_CODE=123456
OTP_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# Configure these for the pilot service area before enabling quotes.
SERVICE_CENTER_LAT=
SERVICE_CENTER_LNG=
SERVICE_RADIUS_METERS=

# Routing: approximate (default), neshan (strict), or auto (Neshan when configured, approximate fallback).
ROUTING_PROVIDER=approximate
ROUTE_DISTANCE_FACTOR=1.25
ROUTE_AVG_SPEED_KMH=25

# Never commit a real Neshan service key. Configure it only in deployment secrets/environment.
NESHAN_SERVICE_API_KEY=
NESHAN_API_BASE_URL=https://api.neshan.org
NESHAN_ROUTING_TIMEOUT_MS=5000
