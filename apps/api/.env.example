DATABASE_URL="postgresql://postgres:postgres@localhost:5432/behshahr_delivery?schema=public"
REDIS_URL="redis://localhost:6379"
API_PORT=4000
NODE_ENV=development
SMS_PROVIDER=console
DEV_OTP_CODE=123456
OTP_SECRET="replace-with-a-long-random-secret"
JWT_ACCESS_SECRET="replace-with-a-long-random-access-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-refresh-secret"

# Configure these for the pilot service area before enabling quotes.
SERVICE_CENTER_LAT=
SERVICE_CENTER_LNG=
SERVICE_RADIUS_METERS=

# Temporary routing estimator; replace through RoutingProvider when a map API is connected.
ROUTE_DISTANCE_FACTOR=1.25
ROUTE_AVG_SPEED_KMH=25
