# Local-only host ports consumed by OpenLiteSpeed reverse proxies and the WooCommerce connector.
DEKAN_API_PORT=4000
DEKAN_COURIER_PORT=3001
DEKAN_ADMIN_PORT=3002

# Generate strong random secrets on the server. Never commit real values.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_POSTGRES_PASSWORD
OTP_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
JWT_ACCESS_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

# Production OTP through IPPanel.
IPPANEL_API_KEY=CHANGE_ME_REAL_IPPANEL_KEY
IPPANEL_FROM_NUMBER=CHANGE_ME_SENDER_NUMBER
IPPANEL_OTP_PATTERN_CODE=CHANGE_ME_PATTERN_CODE
IPPANEL_OTP_PARAM_NAME=code
IPPANEL_API_BASE_URL=https://edge.ippanel.com
IPPANEL_TIMEOUT_MS=5000

# Neshan routing/map.
# For the initial Dekan pilot, both Neshan keys may be left empty and
# ROUTING_PROVIDER=approximate may be used. Add real keys before enabling
# Neshan routing/maps in field operations.
ROUTING_PROVIDER=approximate
NESHAN_SERVICE_API_KEY=
NESHAN_API_BASE_URL=https://api.neshan.org
NESHAN_ROUTING_TIMEOUT_MS=5000
NEXT_PUBLIC_NESHAN_MAP_KEY=

# Behshahr defaults; review before field pilot.
SERVICE_CENTER_LAT=36.6980
SERVICE_CENTER_LNG=53.5520
SERVICE_RADIUS_METERS=15000
ROUTE_DISTANCE_FACTOR=1.25
ROUTE_AVG_SPEED_KMH=25
