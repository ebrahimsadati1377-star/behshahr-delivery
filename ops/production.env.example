# Copy this file to ops/production.env on the server.
# Never commit ops/production.env or real credentials.

# Public domains. Point all three DNS A/AAAA records at the production server.
CUSTOMER_DOMAIN=delivery.example.com
COURIER_DOMAIN=courier.delivery.example.com
ADMIN_DOMAIN=dispatch.delivery.example.com
ACME_EMAIL=ops@example.com

# PostgreSQL. Use a URL-safe random password.
POSTGRES_PASSWORD=replace-with-random-url-safe-password
DATABASE_URL=postgresql://postgres:replace-with-random-url-safe-password@postgres:5432/behshahr_delivery?schema=public

# Application secrets. Generate separate values, at least 32 random bytes each.
OTP_SECRET=replace-with-random-secret
JWT_ACCESS_SECRET=replace-with-different-random-secret
JWT_REFRESH_SECRET=replace-with-another-random-secret

# Production OTP through IPPanel pattern SMS.
IPPANEL_API_KEY=replace-on-server
IPPANEL_FROM_NUMBER=replace-on-server
IPPANEL_OTP_PATTERN_CODE=replace-on-server
IPPANEL_OTP_PARAM_NAME=code
IPPANEL_API_BASE_URL=https://edge.ippanel.com
IPPANEL_TIMEOUT_MS=5000

# Neshan service routing (server-side) and public Web Map key (client-side).
ROUTING_PROVIDER=neshan
NESHAN_SERVICE_API_KEY=replace-on-server
NESHAN_API_BASE_URL=https://api.neshan.org
NESHAN_ROUTING_TIMEOUT_MS=5000
NEXT_PUBLIC_NESHAN_MAP_KEY=replace-web-map-key

# Legacy fallback service radius. Once at least one DB service zone exists,
# active PostGIS zones become the source of truth.
SERVICE_CENTER_LAT=36.6980
SERVICE_CENTER_LNG=53.5520
SERVICE_RADIUS_METERS=15000
ROUTE_DISTANCE_FACTOR=1.25
ROUTE_AVG_SPEED_KMH=25

# Backup / monitoring policy.
BACKUP_DIR=/var/backups/behshahr-delivery
BACKUP_RETENTION_DAYS=14
# Optional webhook receiving a JSON POST when ops/healthcheck.sh fails.
ALERT_WEBHOOK_URL=
